+// Derivadas gruesas a la NVIDIA (ddx_coarse/ddy_coarse): d = FSWZADD(SHFL.IDX(x, carril 0 del quad), x, 0xD7)
+// deja x1 - x0 en el carril 1 y x2 - x0 en el 2, y QuadBroadcast(d, 1 | 2) las reparte por el quad. Sin subgrupos en
+// fragment (Adreno: solo compute) la emulación de Eden devuelve el valor propio y la derivada sale basura (el feedback
+// de AmplifyTexture pedía mips 5-6 por pantalla). Se cambian por OpDPdxCoarse / OpDPdyCoarse.
+void FoldQuadBroadcastDerivative(IR::Block& block, IR::Inst& inst) {
+    const IR::Value lane{inst.Arg(1)};
+    if (!lane.IsImmediate() || (lane.U32() != 1 && lane.U32() != 2)) {
+        return;
+    }
+    const IR::Value swz_value{GetThroughCast(inst.Arg(0).Resolve(), IR::Opcode::BitCastU32F32)};
+    if (swz_value.IsImmediate() || swz_value.InstRecursive()->GetOpcode() != IR::Opcode::FSwizzleAdd) {
+        return;
+    }
+    IR::Inst* const swz{swz_value.InstRecursive()};
+    const IR::Value swizzle{swz->Arg(2)};
+    if (!swizzle.IsImmediate() || swizzle.U32() != 0xD7) {
+        return;
+    }
+    const IR::Value first{GetThroughCast(swz->Arg(0).Resolve(), IR::Opcode::BitCastF32U32)};
+    const IR::Value value{GetThroughCast(swz->Arg(1).Resolve(), IR::Opcode::BitCastF32U32)};
+    if (first.IsImmediate() || value.IsImmediate()) {
+        return;
+    }
+    IR::Inst* const shfl{first.InstRecursive()};
+    if (shfl->GetOpcode() != IR::Opcode::ShuffleIndex) {
+        return;
+    }
+    const IR::Value index{shfl->Arg(1)};
+    const IR::Value clamp{shfl->Arg(2)};
+    const IR::Value segmentation_mask{shfl->Arg(3)};
+    if (!index.IsImmediate() || !clamp.IsImmediate() || !segmentation_mask.IsImmediate() ||
+        index.U32() != 0 || clamp.U32() != 3 || segmentation_mask.U32() != 28) {
+        return;
+    }
+    const IR::Value shuffled{GetThroughCast(shfl->Arg(0).Resolve(), IR::Opcode::BitCastU32F32)};
+    if (shuffled != value) {
+        return;
+    }
+    IR::IREmitter ir{block, IR::Block::InstructionList::s_iterator_to(inst)};
+    const IR::F32 x{value};
+    const IR::F32 d{lane.U32() == 1 ? ir.DPdxCoarse(x) : ir.DPdyCoarse(x)};
+    inst.ReplaceUsesWith(ir.BitCast<IR::U32>(d));
+}
